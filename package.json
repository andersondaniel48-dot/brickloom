{
  "name": "brickloom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Scan, catalog and sort your bricks, then design new builds from what you own and follow step-by-step instructions.",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --mode phone",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "tsx --test shared/*.test.ts",
    "data:fetch": "node scripts/fetch-data.mjs",
    "data:build": "tsx scripts/build-catalog.ts",
    "data": "npm run data:fetch && npm run data:build",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "yauzl": "^3.4.0"
  }
}
